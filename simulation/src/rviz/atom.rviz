Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 43
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: ATOM diagnostic prototype
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.12
      Frames:
        All Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.4
      Focal Point:
        X: 0.15
        Y: 0.20
        Z: 0.04
      Pitch: 0.45
      Yaw: 0.8
      Target Frame: world
Window Geometry:
  Width: 1200
  Height: 800
